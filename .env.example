# ==============================================================================
# ComicAI - Environment Configuration Template
# Copy this file to backend/.env and populate with your credentials.
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# OpenRouter AI API (Required for Story Analysis & Character Bible Generation)
# Obtain from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-sante:free

# Hugging Face Inference API (Required for AI Comic Image Synthesis via FLUX.1-schnell)
# Obtain from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Cloudinary CDN Image Storage (Optional - falls back to Base64 SVG cards if omitted)
# Obtain from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# MongoDB Persistence URI (Optional - comics stored in memory/session if offline)
# Format: mongodb://localhost:27017/comicai or mongodb+srv://<user>:<pass>@cluster.mongodb.net/comicai
MONGODB_URI=mongodb://127.0.0.1:27017/comicai

# JSON Web Token Secret (Required for User Authentication & Sessions)
# Use a strong, random 32+ character string
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
